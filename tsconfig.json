{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["types/**/*.d.ts", "lib/**/*.js", "scripts/**/*.js", "src/_data/**/*.js", "eleventy.config.js"]
}
