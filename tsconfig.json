{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "types/**/*.d.ts",
    "lib/**/*.js",
    "scripts/**/*.js",
    "src/_data/**/*.js",
    "src/assets/js/**/*.js",
    "tests/e2e/**/*.js",
    "playwright.config.js",
    "eleventy.config.js"
  ]
}
