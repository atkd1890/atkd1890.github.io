{
  "name": "atkd1890.github.io",
  "private": true,
  "type": "module",
  "description": "ATKD Coding — GitHub-native showcase site",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "eleventy",
    "start": "eleventy --serve --quiet",
    "clean": "rm -rf _site .cache",
    "test": "node --test \"tests/**/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json",
    "leak-guard": "node scripts/leak-guard.js _site",
    "check": "npm run typecheck && npm test && node scripts/leak-guard.js --self-test",
    "secrets:push": "bash scripts/push-secrets.sh",
    "build:live": "GITHUB_TOKEN=$(gh auth token) SHOWCASE_TOKEN=$(gh auth token) SHOWCASE_REPOS_FILE=../.config/atkd-coding/showcase-repos.json eleventy",
    "leak-guard:local": "LEAK_DENYLIST_FILE=../.config/atkd-coding/leak-denylist.txt SHOWCASE_REPOS_FILE=../.config/atkd-coding/showcase-repos.json SHOWCASE_TOKEN=$(gh auth token) node scripts/leak-guard.js _site --require-denylist --fetch-private"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.8",
    "@11ty/eleventy-fetch": "6.0.1",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.20.5",
    "js-yaml": "5.5.0",
    "typescript": "7.0.2"
  }
}
