{
  "name": "atkd1890.github.io",
  "private": true,
  "type": "module",
  "description": "ATKD Coding — GitHub-native showcase site",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf _site && eleventy && node scripts/postbuild.js",
    "start": "eleventy --serve --quiet",
    "clean": "rm -rf _site .cache",
    "test": "node --test \"tests/**/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json",
    "leak-guard": "node scripts/leak-guard.js _site",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && node scripts/leak-guard.js --self-test",
    "secrets:push": "bash scripts/push-secrets.sh",
    "build:live": "GITHUB_TOKEN=$(gh auth token) SHOWCASE_TOKEN=$(gh auth token) SHOWCASE_REPOS_FILE=../.config/atkd1890.github.io/showcase-repos.json eleventy",
    "leak-guard:local": "LEAK_DENYLIST_FILE=../.config/atkd1890.github.io/leak-denylist.txt SHOWCASE_REPOS_FILE=../.config/atkd1890.github.io/showcase-repos.json SHOWCASE_TOKEN=$(gh auth token) node scripts/leak-guard.js _site --require-denylist --fetch-private",
    "start:live": "GITHUB_TOKEN=$(gh auth token) SHOWCASE_TOKEN=$(gh auth token) SHOWCASE_REPOS_FILE=../.config/atkd1890.github.io/showcase-repos.json eleventy --serve --quiet --port=8081",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "DRAFTS=1 npm run build && npm run og && playwright test --grep-invert @visual",
    "budget": "node scripts/check-budget.js",
    "prepare": "git config core.hooksPath scripts/hooks || true",
    "diagrams": "node scripts/render-diagrams.js",
    "screenshot": "node scripts/screenshot.js",
    "og": "node scripts/og.js",
    "validate:html": "html-validate \"_site/**/*.html\"",
    "lighthouse": "node scripts/lighthouse.js",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "links": "node scripts/check-links.js",
    "links:external": "node scripts/check-links.js --external",
    "test:visual": "DRAFTS=1 npm run build && playwright test --grep @visual"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.8",
    "@11ty/eleventy-fetch": "6.0.1",
    "@11ty/eleventy-plugin-rss": "3.1.0",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@playwright/test": "1.65.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "html-validate": "11.17.0",
    "js-yaml": "5.5.0",
    "lighthouse": "13.6.0",
    "markdown-it-anchor": "10.1.0",
    "mermaid": "12.3.0",
    "pagefind": "1.5.2",
    "prettier": "3.10.0",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "7.0.2"
  }
}
