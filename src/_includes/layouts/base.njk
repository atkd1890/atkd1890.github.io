{#- Language context: pages paginate over i18n.langs with alias L, and set basePath (URL without
    the language prefix) so the switcher and hreflang can link to the same page in other languages. -#}
{%- if L is string %}{% set L = i18n.langs | where('code', L) | first %}{% endif -%}
{%- set L = L or i18n.langs[0] -%}
{%- set t = i18n.t[L.code] -%}
{%- set home = L.prefix + '/' -%}
{%- set description = summary | tr(L.code) if summary else site.tagline | tr(L.code) -%}
{%- set pageTitle -%}{% if title and title != site.title %}{{ title | tr(L.code) }} · {% endif %}{{ site.title }}{%- endset -%}
{#- The only inline script. CSP allows it by hash, so changing it updates the policy automatically. -#}
{%- set themeScript = "try{var t=localStorage.getItem('theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t}catch(e){}" -%}
<!doctype html>
<html lang="{{ L.code }}" data-home="{{ home }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' {{ themeScript | cspHash | safe }} 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="{{ 'article' if postSlug else 'website' }}">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}{{ page.url | ogPath }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ pageTitle }}">
  <meta property="og:locale" content="{{ L.locale }}">
  <meta name="twitter:card" content="summary_large_image">
  {%- if postSlug %}
  <script type="application/ld+json">{{ { kind: 'post', url: page.url, title: title, description: description, lang: L.code, date: date, image: site.url + (page.url | ogPath) } | jsonLd(site) | safe }}</script>
  {%- elif page.url == home %}
  <script type="application/ld+json">{{ { kind: 'home', url: page.url, description: description, lang: L.code } | jsonLd(site) | safe }}</script>
  {%- elif jsonLdKind == 'tools' %}
  <script type="application/ld+json">{{ { kind: 'tools', url: page.url, tools: github.tools } | jsonLd(site) | safe }}</script>
  {%- endif %}
  {%- if postSlug %}
  {%- set versions = collections.posts | versionsOf(postSlug) %}
  {%- for l in i18n.langs %}{% if versions[l.code] %}
  <link rel="alternate" hreflang="{{ l.code }}" href="{{ site.url }}{{ versions[l.code] }}">
  {%- endif %}{% endfor %}
  {%- elif basePath %}
  {%- for l in i18n.langs %}
  <link rel="alternate" hreflang="{{ l.code }}" href="{{ site.url }}{{ l.prefix }}{{ basePath }}">
  {%- endfor %}
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ basePath }}">
  {%- endif %}
  <link rel="alternate" type="application/atom+xml" title="ATKD Coding" href="/feed.xml">
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="#f4f5f8" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#0d1117" media="(prefers-color-scheme: dark)">
  <link rel="icon" href="/assets/icons/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon.png">
  <link rel="manifest" href="/manifest.webmanifest">
  <script>{{ themeScript | safe }}</script>
  <link rel="preload" href="/assets/fonts/jetbrains-mono-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/main.css">
  <script type="module" src="/assets/js/craft.js"></script>
</head>
<body>
  <a class="skip" href="#main">{{ t.skip }}</a>
  <header class="titlebar">
    <a class="titlebar-label" href="{{ home }}">~/atkd-coding — zsh<span class="visually-hidden"> · {{ t.items.home }}</span></a>
    <div class="titlebar-right">
      {% if nav %}
      <nav class="sections" aria-label="{{ t.sections }}">
        {% for key in nav %}<a href="#{{ key }}">{{ t.nav[key] }}</a>{% endfor %}
      </nav>
      {% endif %}
      <nav class="langs" aria-label="{{ t.language }}">
        {% for l in i18n.langs %}<a href="{% if postSlug %}{{ versions[l.code] or (l.prefix + '/blog/') }}{% else %}{{ l.prefix }}{{ basePath or '/' }}{% endif %}" hreflang="{{ l.code }}" lang="{{ l.code }}"{% if l.code == L.code %} aria-current="page"{% endif %}><span aria-hidden="true">{{ l.label }}</span><span class="visually-hidden">{{ l.name }}</span></a>{% endfor %}
      </nav>
      <div class="controls" data-js hidden>
        <button type="button" class="ctl ctl-wide" data-palette-open aria-keyshortcuts="Meta+K Control+K"><kbd>⌘K</kbd><span class="visually-hidden"> {{ t.palette }}</span></button>
        <button type="button" class="ctl" data-sound-toggle aria-pressed="false" aria-label="{{ t.sound }}">
          <svg data-sound-off width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 9h4l5-4v14l-5-4H4z"/><path d="M17 9l4 6M21 9l-4 6"/></svg>
          <svg data-sound-on hidden width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 9h4l5-4v14l-5-4H4z"/><path d="M16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12"/></svg>
        </button>
        <button type="button" class="ctl" data-theme-toggle data-label-light="{{ t.themeTo.light }}" data-label-dark="{{ t.themeTo.dark }}" aria-label="{{ t.themeTo.dark }}">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/></svg>
        </button>
      </div>
    </div>
  </header>
  {#- Breadcrumb on every page except home: ~ / blog / <page>. -#}
  {%- set isHome = page.url == home -%}
  {%- if not isHome %}
  <nav class="wrap{% if wide %} wide{% endif %} breadcrumb" aria-label="{{ t.breadcrumb }}">
    <ol>
      <li><a href="{{ home }}">~<span class="visually-hidden"> {{ t.items.home }}</span></a></li>
      {%- if postSlug or bp %}
      {%- if postSlug or bp.kind != 'all' %}<li><a href="{{ L.prefix }}/blog/">blog</a></li>{% else %}<li aria-current="page">blog</li>{% endif %}
      {%- endif %}
      {%- if postSlug %}<li aria-current="page">{{ title }}</li>
      {%- elif bp and bp.kind != 'all' %}<li aria-current="page">{% if bp.kind == 'type' %}{{ t.blog.types[bp.value] }}{% elif bp.kind == 'tag' %}#{{ bp.value }}{% else %}{{ bp.value }}{% endif %}</li>
      {%- elif not bp %}<li aria-current="page">{{ title | tr(L.code) }}</li>{% endif %}
    </ol>
  </nav>
  {%- endif %}
  <main id="main" class="wrap{% if wide %} wide{% endif %}"{% if searchable != false %} data-pagefind-body{% endif %}>
    {{ content | safe }}
  </main>
  <footer class="wrap{% if wide %} wide{% endif %} site-footer">
    <p class="prompt">cat links.txt</p>
    <nav aria-label="atkd1890">
      <a href="{{ site.hub }}">atkd1890.me</a>
      <a href="{{ site.github }}">GitHub</a>
      <a href="mailto:{{ site.email }}">{{ site.email }}</a>
      <a href="{{ L.prefix }}/uses/">/{{ t.usesLink }}</a>
      <a href="{{ L.prefix }}/colophon/">/{{ t.colophonLink }}</a>
    </nav>
    <p class="meta">
      {{ t.license }} <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a> · Code MIT ·
      <a href="https://github.com/{{ site.repo }}/edit/{{ site.branch }}/{{ page.inputPath | replace('./', '') }}">{{ t.edit }}</a> ·
      {{ t.built }} <time datetime="{{ site.buildTime | isoDate }}">{{ site.buildTime | isoDate | truncate(10, true, '') }}</time>
      <span data-js hidden>· <button type="button" class="linklike" data-help-open>{{ t.shortcutsHint }}</button></span>
      · {{ t.data }} {{ github.source }}{% if github.demo %} (demo){% endif %}, {{ github.signals.totalContributions }} {{ t.contributions }}
    </p>
  </footer>
  <dialog id="palette" class="dialog palette" aria-label="{{ t.palette }}">
    <div class="pal-input">
      <span aria-hidden="true">$</span>
      <label for="pal-q" class="visually-hidden">{{ t.paletteInput }}</label>
      <input id="pal-q" type="text" role="combobox" aria-expanded="true" aria-controls="pal-list" aria-autocomplete="list" autocomplete="off" spellcheck="false" placeholder="{{ t.palettePlaceholder }}">
      <form method="dialog"><button type="submit" class="ctl">esc<span class="visually-hidden"> {{ t.close }}</span></button></form>
    </div>
    <ul id="pal-list" role="listbox" aria-label="{{ t.results }}" data-no-match="{{ t.noMatch }}" data-search-group="{{ t.groups.search }}"></ul>
    <p class="pal-foot">{{ t.paletteFoot }}</p>
  </dialog>
  <dialog id="shortcuts" class="dialog" aria-labelledby="shortcuts-title">
    <h2 id="shortcuts-title">{{ t.shortcuts.title }}</h2>
    <dl class="keys">
      <dt><kbd>⌘K</kbd> / <kbd>Ctrl K</kbd></dt><dd>{{ t.shortcuts.palette }}</dd>
      <dt><kbd>/</kbd></dt><dd>{{ t.shortcuts.search }}</dd>
      <dt><kbd>g</kbd> <kbd>h</kbd></dt><dd>{{ t.shortcuts.home }}</dd>
      <dt><kbd>g</kbd> <kbd>w</kbd></dt><dd>{{ t.shortcuts.work }}</dd>
      <dt><kbd>g</kbd> <kbd>s</kbd></dt><dd>{{ t.shortcuts.signals }}</dd>
      <dt><kbd>g</kbd> <kbd>b</kbd></dt><dd>{{ t.shortcuts.blog }}</dd>
      <dt><kbd>?</kbd></dt><dd>{{ t.shortcuts.help }}</dd>
      <dt><kbd>esc</kbd></dt><dd>{{ t.shortcuts.close }}</dd>
    </dl>
    <form method="dialog"><button type="submit" class="ctl ctl-wide">{{ t.close }}</button></form>
  </dialog>
  <script type="application/json" id="palette-items">{{ showcase | paletteItems(site, t, L.prefix) | dump | safe }}</script>
</body>
</html>
